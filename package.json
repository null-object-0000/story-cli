{
  "name": "storypack",
  "version": "0.1.0",
  "private": true,
  "description": "让每一本故事拥有一个会随着读者一起成长、绝不剧透、并以这个故事自己的方式呈现知识的智能百科与阅读伴侣",
  "type": "module",
  "bin": {
    "story": "dist/src/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node dist/src/cli/index.js tui"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "sqlite3": "^6.0.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true
  }
}
